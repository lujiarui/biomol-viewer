{
  "name": "biomol-viewer",
  "private": true,
  "version": "2.1.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "serve": "npm run build && npm start",
    "start": "node dist/server.mjs",
    "clean": "node scripts/clean.mjs",
    "compact": "npm run build && node scripts/clean.mjs --dependencies",
    "test:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "molstar": "5.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "esbuild": "0.28.2"
  }
}
